rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // A user may never change their own `role` (privilege escalation guard).
    // Admin status itself is enforced via custom claims, but the stored role
    // field should stay trustworthy too.
    function roleUnchanged() {
      return !request.resource.data.diff(resource.data)
        .affectedKeys().hasAny(['role']);
    }

    match /users/{userId} {
      allow create: if isOwner(userId)
        && request.resource.data.get('role', 'user') == 'user';
      allow read: if isOwner(userId) || isAdmin();
      allow update: if isAdmin() || (isOwner(userId) && roleUnchanged());
      allow delete: if isAdmin();

      match /childProfiles/{profileId} {
        // Owner-only. New cloud-mirrored fields are type-guarded so a
        // malformed client write cannot store the wrong shape:
        // `dailyStreak` is the login-claim int (legacy) *or* a practice
        // streak map; `practiceStreak` is always a map; `unlockedItems`
        // is a list of avatar-item ids. Inventory never goes on the
        // public leaderboard.
        allow read: if isOwner(userId);
        allow write: if isOwner(userId)
          && (
            !request.resource.data.keys().hasAny(['dailyStreak'])
            || request.resource.data.dailyStreak is int
            || request.resource.data.dailyStreak is map
          )
          && (
            !request.resource.data.keys().hasAny(['practiceStreak'])
            || request.resource.data.practiceStreak is map
          )
          && (
            !request.resource.data.keys().hasAny(['unlockedItems'])
            || request.resource.data.unlockedItems is list
          );
      }

      match /gameData/{docId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Privacy-safe global leaderboard.
    // Each signed-in user may publish/maintain entries only for their own
    // profiles (doc id must be "<uid>_<profileId>"), with a strict field
    // whitelist so no extra child data can leak into the shared collection.
    match /leaderboard/{entryId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn()
        && entryId == request.auth.uid + '_' + request.resource.data.profileId
        && request.resource.data.keys().hasOnly([
          'profileId', 'displayName', 'coins', 'dailyStreak',
          'avatarColor', 'avatarId', 'equippedAvatar', 'updatedAt'
        ])
        && request.resource.data.profileId is string
        && request.resource.data.profileId.size() > 0
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 40
        && request.resource.data.coins is int
        && request.resource.data.coins >= 0
        && request.resource.data.dailyStreak is int
        && request.resource.data.dailyStreak >= 0
        && request.resource.data.avatarColor is int
        // avatarId is optional: the client only writes it when the child has
        // picked an animal-emoji avatar. When present it must be a short,
        // non-identifying string (one emoji, allowing for ZWJ sequences).
        && (
          !request.resource.data.keys().hasAny(['avatarId'])
          || (
            request.resource.data.avatarId is string
            && request.resource.data.avatarId.size() > 0
            && request.resource.data.avatarId.size() <= 12
          )
        )
        // equippedAvatar is optional: only written once a child has equipped
        // at least one Avatar Customization item. When present it must be a
        // map of slot -> item id (hatId/shirtId/accessoryId/backgroundId).
        && (
          !request.resource.data.keys().hasAny(['equippedAvatar'])
          || request.resource.data.equippedAvatar is map
        );
      allow delete: if isSignedIn()
        && entryId.split('_')[0] == request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
